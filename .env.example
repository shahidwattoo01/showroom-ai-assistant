# ============================================================================
# Copy this file to  .env  and fill in what you need. Everything has a safe
# default, so the app runs out of the box with NO configuration (demo mode).
# ============================================================================

# ---- AI (Claude) -----------------------------------------------------------
# Leave blank to run in offline DEMO mode (keyword bot, no API calls).
# Set a key to use real Claude agents. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODE=auto                 # auto | claude | demo
LLM_MODEL=claude-opus-5-5     # main agent model
ROUTER_MODEL=claude-haiku-5-5 # cheap/fast model for routing + staff parsing
LLM_EFFORT=low                # low | medium | high  (low = fast chat replies)

# ---- Database --------------------------------------------------------------
# Local default: a SQLite file in data/showroom.db  (nothing to install).
# To move to the cloud (Supabase / PostgreSQL), just change this one line:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (and uncomment psycopg in requirements.txt)
DATABASE_URL=
SEED_DEMO_DATA=true           # load sample cars/parts/customers on first run

# ---- Showroom details (shown to customers) ---------------------------------
SHOWROOM_NAME=Demo Motors
SHOWROOM_ADDRESS=Plot 12, Main Boulevard, Gulberg III, Lahore
SHOWROOM_PHONE=+92 42 111 000 111
SHOWROOM_HOURS=Mon-Sat 9:00 AM - 6:00 PM, Sunday closed
SHOWROOM_MAPS_URL=https://maps.google.com/?q=Gulberg+III+Lahore
TIMEZONE=Asia/Karachi
CURRENCY=PKR
DEFAULT_COUNTRY_CODE=92

# ---- Admin login -----------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123        # CHANGE THIS before going live
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000

# ---- WhatsApp (Meta Cloud API) — optional ----------------------------------
# Leave blank to use the built-in simulator in the admin panel instead.
# Webhook URL to set in Meta:  {PUBLIC_BASE_URL}/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=demo-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ---- Voice notes (speech to text / text to speech) — optional --------------
# Any Whisper-compatible API (OpenAI, Groq, self-hosted).
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
VOICE_NOTE_REPLIES=false       # true = reply to voice notes with a voice note

# ---- Phone calls (Twilio) — optional ---------------------------------------
# Point your Twilio number's voice webhook to  {PUBLIC_BASE_URL}/voice/incoming
TWILIO_AUTH_TOKEN=
CALL_LANGUAGE=en-IN
CALL_VOICE=Polly.Raveena
CALL_TRANSFER_NUMBER=          # human fallback number for handoff

# ---- Booking capacity / working hours --------------------------------------
WORK_START_HOUR=9
WORK_END_HOUR=17
CLOSED_WEEKDAYS=6              # 0=Mon ... 6=Sun
SERVICE_SLOT_CAPACITY=3
TEST_DRIVE_SLOT_CAPACITY=2

# ---- Financing defaults ----------------------------------------------------
FINANCE_ANNUAL_RATE=18
FINANCE_MIN_DOWN_PERCENT=30
FINANCE_MAX_YEARS=5

# ---- Background jobs -------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=10
BACKUP_KEEP_DAYS=14
STAFF_UNDO_MINUTES=10
